{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "title": {
    "text": "How does event activity change over time?",
    "subtitle": "Monthly counts of event records with valid start dates.",
    "anchor": "start"
  },
  "data": {
    "url": "brisbane-markets.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "timeParse(datum['Start Date'], '%m/%d/%Y')",
      "as": "ParsedDate"
    },
    {
      "filter": "isValid(datum.ParsedDate)"
    },
    {
      "timeUnit": "yearmonth",
      "field": "ParsedDate",
      "as": "Month"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Events"
        }
      ],
      "groupby": [
        "Month"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "size": 45
        },
        "strokeWidth": 2,
        "color": "#9B8AD4"
      },
      "encoding": {
        "x": {
          "field": "Month",
          "type": "temporal",
          "title": "Month",
          "axis": {
            "format": "%b %Y",
            "labelAngle": -35
          }
        },
        "y": {
          "field": "Events",
          "type": "quantitative",
          "title": "Event records per month"
        },
        "tooltip": [
          {
            "field": "Month",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "Events",
            "type": "quantitative",
            "title": "Event records"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 9,
        "fontWeight": "bold",
        "color": "#6C5AA8"
      },
      "encoding": {
        "x": {
          "field": "Month",
          "type": "temporal"
        },
        "y": {
          "field": "Events",
          "type": "quantitative"
        },
        "text": {
          "field": "Events",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#596579",
      "titleColor": "#6C5AA8",
      "gridColor": "#E4EAF3"
    }
  }
}