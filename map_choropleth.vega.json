{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 460,
  "height": 360,
  "title": {
    "text": "1. Choropleth Map: Total Markets by State",
    "fontSize": 14,
    "font": "Arial",
    "anchor": "middle"
  },
  "projection": {"type": "mercator", "center": [133, -27], "scale": 500},
  "layer": [
    {
      "data": {
        "url": "aus_state.topojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {"calculate": "datum.properties.STATE_NAME", "as": "StateName"},
        {
          "lookup": "StateName",
          "from": {
            "data": {
              "values": [
                {"State": "New South Wales", "Code": "NSW", "TotalMarkets": 15},
                {"State": "Victoria", "Code": "VIC", "TotalMarkets": 13},
                {"State": "South Australia", "Code": "SA", "TotalMarkets": 3},
                {"State": "Western Australia", "Code": "WA", "TotalMarkets": 3},
                {"State": "Queensland", "Code": "QLD", "TotalMarkets": 2},
                {"State": "Tasmania", "Code": "TAS", "TotalMarkets": 2},
                {"State": "Australian Capital Territory", "Code": "ACT", "TotalMarkets": 1},
                {"State": "Northern Territory", "TotalMarkets": 0}
              ]
            },
            "key": "State",
            "fields": ["TotalMarkets", "Code"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {
        "color": {
          "field": "TotalMarkets",
          "type": "quantitative",
          "title": "Total Markets",
          "scale": {"scheme": "blues"},
          "legend": {"offset": 25}
        },
        "tooltip": [
          {"field": "StateName", "type": "nominal", "title": "State"},
          {"field": "TotalMarkets", "type": "quantitative", "title": "Total Markets"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"Label": "NSW (15)", "longitude": 146.5, "latitude": -32.0},
          {"Label": "VIC (13)", "longitude": 144.5, "latitude": -37.0},
          {"Label": "QLD (2)", "longitude": 144.0, "latitude": -23.0},
          {"Label": "SA (3)", "longitude": 133.0, "latitude": -30.0},
          {"Label": "WA (3)", "longitude": 122.0, "latitude": -26.0},
          {"Label": "TAS (2)", "longitude": 147.0, "latitude": -42.0},
          {"Label": "ACT (1)", "longitude": 149.13, "latitude": -35.28}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#000000",
        "dy": -10
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "Label", "type": "nominal"}
      }
    }
  ]
}
