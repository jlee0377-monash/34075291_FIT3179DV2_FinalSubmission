{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 460,
  "height": 360,
  "title": {
    "text": "4. Layered Map: State Totals vs Node Scale",
    "fontSize": 14,
    "font": "Arial",
    "anchor": "middle"
  },
  "projection": {"type": "mercator", "center": [133, -27], "scale": 500},
  "layer": [
    {
      "data": {
        "url": "aus_state.topojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {"calculate": "datum.properties.STATE_NAME", "as": "StateName"},
        {
          "lookup": "StateName",
          "from": {
            "data": {
              "values": [
                {"State": "New South Wales", "TotalMarkets": 15},
                {"State": "Victoria", "TotalMarkets": 13},
                {"State": "South Australia", "TotalMarkets": 3},
                {"State": "Western Australia", "TotalMarkets": 3},
                {"State": "Queensland", "TotalMarkets": 2},
                {"State": "Tasmania", "TotalMarkets": 2},
                {"State": "Australian Capital Territory", "TotalMarkets": 1},
                {"State": "Northern Territory", "TotalMarkets": 0}
              ]
            },
            "key": "State",
            "fields": ["TotalMarkets"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {
        "color": {
          "field": "TotalMarkets",
          "type": "quantitative",
          "title": "Total Markets",
          "scale": {"scheme": "purples"}
        },
        "tooltip": [
          {"field": "StateName", "type": "nominal", "title": "State"},
          {"field": "TotalMarkets", "type": "quantitative", "title": "Total Markets"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"State": "NSW", "longitude": 147.0, "latitude": -32.0, "Count": 15},
          {"State": "VIC", "longitude": 145.0, "latitude": -37.0, "Count": 13},
          {"State": "SA", "longitude": 133.0, "latitude": -30.0, "Count": 3},
          {"State": "WA", "longitude": 122.0, "latitude": -25.0, "Count": 3},
          {"State": "QLD", "longitude": 144.0, "latitude": -22.0, "Count": 2},
          {"State": "TAS", "longitude": 147.0, "latitude": -42.0, "Count": 2},
          {"State": "ACT", "longitude": 149.13, "latitude": -35.28, "Count": 1}
        ]
      },
      "mark": {"type": "circle", "opacity": 0.85, "color": "#10b981", "stroke": "#047857", "strokeWidth": 1.5},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "Count",
          "type": "quantitative",
          "title": "Scale",
          "scale": {"range": [80, 600]}
        },
        "tooltip": [
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Count", "type": "quantitative", "title": "Count"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"Label": "NSW (15)", "longitude": 147.0, "latitude": -32.0},
          {"Label": "VIC (13)", "longitude": 145.0, "latitude": -37.0},
          {"Label": "QLD (2)", "longitude": 144.0, "latitude": -22.0},
          {"Label": "SA (3)", "longitude": 133.0, "latitude": -30.0},
          {"Label": "WA (3)", "longitude": 122.0, "latitude": -26.0},
          {"Label": "TAS (2)", "longitude": 147.0, "latitude": -42.0},
          {"Label": "ACT (1)", "longitude": 149.13, "latitude": -35.28}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#000000",
        "dy": -16
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "Label", "type": "nominal"}
      }
    }
  ]
}
